{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-world-system.local/schemas/v1/protected-production-asset.schema.json",
  "title": "Protected production asset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asset_id", "version", "brand_id", "label", "source", "handling", "protected_elements", "provenance", "rights"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "asset_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "brand_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "label": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "source": { "$ref": "common.schema.json#/$defs/source_reference" },
    "handling": {
      "type": "object", "additionalProperties": false, "required": ["mode", "allowed_operations"],
      "properties": {
        "mode": { "enum": ["exact", "bounded"] },
        "allowed_operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["compose_exact", "crop_with_safe_area", "resize_proportionally", "recolor_with_approved_map", "substitute_approved_variant"] } },
        "bounds": { "type": "object", "minProperties": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "exact" } }, "required": ["mode"] },
          "then": {
            "properties": { "allowed_operations": { "type": "array", "const": ["compose_exact"] } },
            "not": { "required": ["bounds"] }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "bounded" } }, "required": ["mode"] },
          "then": { "required": ["bounds"] }
        }
      ]
    },
    "protected_elements": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "rights": {
      "type": "object", "additionalProperties": false, "required": ["status", "usage_scope"],
      "properties": { "status": { "const": "cleared" }, "usage_scope": { "$ref": "common.schema.json#/$defs/non_empty_string" } }
    }
  }
}
