{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-world-system.local/schemas/v1/deliverable-preset.schema.json",
  "title": "Deliverable preset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "preset_id", "version", "brand_id", "label", "output_type", "placement_profiles", "policy"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "preset_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "brand_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "label": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "output_type": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "version": { "$ref": "common.schema.json#/$defs/version" } }
    },
    "placement_profiles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "version", "formats"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/identifier" },
          "version": { "$ref": "common.schema.json#/$defs/version" },
          "formats": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } }
        }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "preset", "decisions", "component_policies", "capabilities", "evaluation_order"],
      "properties": {
        "policy_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "preset": { "enum": ["constrained", "hybrid", "editorial"] },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "effect", "component", "instruction", "rationale"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/identifier" },
              "effect": { "enum": ["required", "permitted", "conditional", "prohibited"] },
              "component": { "$ref": "common.schema.json#/$defs/component" },
              "instruction": { "$ref": "common.schema.json#/$defs/non_empty_string" },
              "rationale": { "$ref": "common.schema.json#/$defs/non_empty_string" },
              "semantic_tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } }
            }
          }
        },
        "component_policies": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["component", "handling", "accepts_creative_influence", "compatible_roles", "compatible_source_types"],
            "properties": {
              "component": { "$ref": "common.schema.json#/$defs/component" },
              "handling": { "enum": ["locked", "bounded", "flexible", "excluded"] },
              "accepts_creative_influence": { "type": "boolean" },
              "compatible_roles": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
              "compatible_source_types": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } }
            }
          }
        },
        "capabilities": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "kind"],
            "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "kind": { "enum": ["deterministic", "judgment"] } }
          }
        },
        "evaluation_order": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "kind", "blocking"],
            "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "kind": { "enum": ["deterministic", "judgment", "human"] }, "blocking": { "type": "boolean" } }
          }
        }
      }
    }
  }
}
