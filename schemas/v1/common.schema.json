{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-world-system.local/schemas/v1/common.schema.json",
  "title": "Brand World System common definitions",
  "$defs": {
    "schema_version": { "const": "1.0.0" },
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "minLength": 2 },
    "version": { "type": "string", "minLength": 1 },
    "non_empty_string": { "type": "string", "minLength": 1 },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "component": {
      "enum": [
        "protected_subject",
        "brand_foundation",
        "world_direction",
        "visual_grammar",
        "lighting_and_composition",
        "materials_and_palette",
        "voice_and_claims",
        "output_requirements",
        "prohibitions"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_ref"],
      "properties": {
        "source_kind": { "$ref": "#/$defs/non_empty_string" },
        "source_ref": { "$ref": "#/$defs/non_empty_string" },
        "captured_by": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rationale"],
      "properties": {
        "level": { "enum": ["unknown", "low", "medium", "high"] },
        "method": { "$ref": "#/$defs/non_empty_string" },
        "rationale": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "epistemic_confidence": {
      "allOf": [
        { "$ref": "#/$defs/confidence" },
        { "type": "object", "required": ["method"] }
      ]
    },
    "scope": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "brand_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "product_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "channels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "placements": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "formats": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "campaigns": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "media_type", "checksum"],
      "properties": {
        "uri": { "$ref": "#/$defs/non_empty_string" },
        "media_type": { "$ref": "#/$defs/non_empty_string" },
        "checksum": { "$ref": "#/$defs/checksum" }
      }
    }
  }
}
