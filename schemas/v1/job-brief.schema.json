{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-world-system.local/schemas/v1/job-brief.schema.json",
  "title": "Job brief and explicit constraints",
  "description": "User-authored request data. installation_id is intentionally not accepted here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "preset_ref", "objective", "scope", "output", "requirements", "exclusions", "protected_asset_refs"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "job_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "preset_ref": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "version": { "$ref": "common.schema.json#/$defs/version" } }
    },
    "objective": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["brand_id", "channel", "placement", "format"],
      "properties": {
        "brand_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "product_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "channel": { "$ref": "common.schema.json#/$defs/identifier" },
        "placement": { "$ref": "common.schema.json#/$defs/identifier" },
        "format": { "$ref": "common.schema.json#/$defs/identifier" },
        "campaign": { "$ref": "common.schema.json#/$defs/identifier" }
      }
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["quantity", "text_policy"],
      "properties": { "quantity": { "type": "integer", "minimum": 1 }, "text_policy": { "enum": ["none", "external", "editable_layer", "template_slot", "embedded"] } }
    },
    "requirements": { "$ref": "#/$defs/constraints" },
    "exclusions": { "$ref": "#/$defs/constraints" },
    "protected_asset_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } }
  },
  "$defs": {
    "constraints": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "component", "instruction"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/identifier" },
          "component": { "$ref": "common.schema.json#/$defs/component" },
          "instruction": { "$ref": "common.schema.json#/$defs/non_empty_string" },
          "conflicts_with": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } }
        }
      }
    }
  }
}
