{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-world-system.local/schemas/v1/resolution-receipt.schema.json",
  "title": "Resolution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "package_id", "compiler", "decisions", "summary"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "receipt_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "package_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "compiler": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": { "id": { "const": "brand-world-production-compiler" }, "version": { "$ref": "common.schema.json#/$defs/version" } }
    },
    "decisions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["subject_type", "subject_ref", "status", "reason", "authority", "resolution_basis"],
        "properties": {
          "subject_type": { "enum": ["governed_entity", "preset_decision", "job_requirement", "job_exclusion", "protected_asset", "supplemental_input"] },
          "subject_ref": { "$ref": "common.schema.json#/$defs/non_empty_string" },
          "status": { "enum": ["included", "partially_included", "excluded", "overridden"] },
          "component_ref": { "$ref": "common.schema.json#/$defs/component" },
          "reason": { "$ref": "common.schema.json#/$defs/non_empty_string" },
          "authority": { "$ref": "common.schema.json#/$defs/non_empty_string" },
          "lifecycle": { "enum": ["proposed", "approved", "rejected", "deprecated", "superseded"] },
          "resolution_basis": { "$ref": "common.schema.json#/$defs/non_empty_string" },
          "included_evidence_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" } },
          "excluded_evidence_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" } },
          "influence": { "enum": ["lead", "strong", "supporting", "light"] },
          "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
          "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["included", "partially_included", "excluded", "overridden"],
      "properties": {
        "included": { "type": "integer", "minimum": 0 },
        "partially_included": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 },
        "overridden": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
