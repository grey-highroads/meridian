{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-world-system.local/schemas/v1/supplemental-production-input.schema.json",
  "title": "Supplemental production input",
  "description": "Reader evidence, not governance. Claims and policy exceptions are intentionally absent and rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_id", "source", "provenance", "authority_class", "intent", "role", "intended_components", "influence", "usage_instruction", "reader", "confidence", "evidence"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "input_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["type", "ref", "label"],
      "properties": {
        "type": { "enum": ["image", "image_grid", "webpage", "named_reference", "text_excerpt", "asset_reference"] },
        "ref": { "$ref": "common.schema.json#/$defs/non_empty_string" },
        "label": { "$ref": "common.schema.json#/$defs/non_empty_string" }
      }
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "authority_class": { "enum": ["creative_evidence", "negative_evidence"] },
    "intent": { "enum": ["positive_reference", "differentiate_away"] },
    "role": { "$ref": "common.schema.json#/$defs/identifier" },
    "intended_components": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/component" } },
    "influence": { "enum": ["lead", "strong", "supporting", "light"] },
    "usage_instruction": { "$ref": "common.schema.json#/$defs/non_empty_string" },
    "reader": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "version": { "$ref": "common.schema.json#/$defs/version" } }
    },
    "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "observation", "semantic_tags", "compatible_components", "conflicts_with"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/identifier" },
          "observation": { "$ref": "common.schema.json#/$defs/non_empty_string" },
          "semantic_tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
          "compatible_components": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/component" } },
          "conflicts_with": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "authority_class": { "const": "creative_evidence" } }, "required": ["authority_class"] }, "then": { "properties": { "intent": { "const": "positive_reference" } } } },
    { "if": { "properties": { "authority_class": { "const": "negative_evidence" } }, "required": ["authority_class"] }, "then": { "properties": { "intent": { "const": "differentiate_away" } } } }
  ]
}
