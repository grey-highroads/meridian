{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-world-system.local/schemas/v1/generation-package.schema.json",
  "title": "Portable generation package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "compiler", "installation", "source_refs", "output_specification", "components", "compiled_prompt", "negative_instructions", "generation_inputs", "renderer_contract", "resolution_receipt_ref"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "package_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "compiler": { "$ref": "#/$defs/compiler" },
    "installation": {
      "type": "object", "additionalProperties": false, "required": ["installation_id", "profile_version", "core_version"],
      "properties": {
        "installation_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "profile_version": { "$ref": "common.schema.json#/$defs/version" },
        "core_version": { "$ref": "common.schema.json#/$defs/version" }
      }
    },
    "source_refs": {
      "type": "object", "additionalProperties": false, "required": ["brand_brain_snapshot", "deliverable_preset", "job_brief"],
      "properties": {
        "brand_brain_snapshot": { "$ref": "#/$defs/versioned_ref" },
        "deliverable_preset": { "$ref": "#/$defs/versioned_ref" },
        "job_brief": { "$ref": "#/$defs/versioned_ref" }
      }
    },
    "output_specification": {
      "type": "object", "additionalProperties": false,
      "required": ["output_type", "deliverable_preset", "placement_profile", "format", "quantity", "text_policy"],
      "properties": {
        "output_type": { "$ref": "#/$defs/labeled_versioned_ref" },
        "deliverable_preset": { "$ref": "#/$defs/labeled_versioned_ref" },
        "placement_profile": { "$ref": "#/$defs/labeled_versioned_ref" },
        "format": { "$ref": "common.schema.json#/$defs/identifier" },
        "quantity": { "type": "integer", "minimum": 1 },
        "text_policy": { "enum": ["none", "external", "editable_layer", "template_slot", "embedded"] }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "handling", "instructions"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/component" },
          "handling": { "enum": ["locked", "bounded", "flexible", "excluded"] },
          "instructions": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["text", "source_ref", "authority", "production_effect", "provenance"],
              "properties": {
                "text": { "$ref": "common.schema.json#/$defs/non_empty_string" },
                "source_ref": { "$ref": "common.schema.json#/$defs/non_empty_string" },
                "authority": { "$ref": "common.schema.json#/$defs/non_empty_string" },
                "lifecycle": { "enum": ["proposed", "approved", "rejected", "deprecated", "superseded"] },
                "production_effect": { "enum": ["required", "permitted", "conditional", "prohibited"] },
                "epistemic_origin": { "enum": ["sourced", "inferred", "authored", "generated"] },
                "influence": { "enum": ["lead", "strong", "supporting", "light"] },
                "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
                "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
              }
            }
          }
        }
      }
    },
    "compiled_prompt": {
      "type": "object", "additionalProperties": false, "required": ["positive", "negative"],
      "properties": { "positive": { "$ref": "common.schema.json#/$defs/non_empty_string" }, "negative": { "type": "string" } }
    },
    "negative_instructions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["text", "source_ref", "authority", "provenance"],
        "properties": {
          "text": { "$ref": "common.schema.json#/$defs/non_empty_string" },
          "source_ref": { "$ref": "common.schema.json#/$defs/non_empty_string" },
          "authority": { "$ref": "common.schema.json#/$defs/non_empty_string" },
          "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
        }
      }
    },
    "generation_inputs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "input_type", "role", "handling", "source", "provenance"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/identifier" },
          "input_type": { "enum": ["protected_asset", "creative_evidence", "negative_evidence"] },
          "role": { "$ref": "common.schema.json#/$defs/non_empty_string" },
          "handling": { "enum": ["exact", "bounded", "flexible"] },
          "source": {
            "oneOf": [
              { "$ref": "common.schema.json#/$defs/source_reference" },
              {
                "type": "object", "additionalProperties": false, "required": ["type", "ref", "label"],
                "properties": {
                  "type": { "enum": ["image", "image_grid", "webpage", "named_reference", "text_excerpt", "asset_reference"] },
                  "ref": { "$ref": "common.schema.json#/$defs/non_empty_string" },
                  "label": { "$ref": "common.schema.json#/$defs/non_empty_string" }
                }
              }
            ]
          },
          "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
          "protected_elements": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" } },
          "allowed_operations": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" } },
          "influence": { "enum": ["lead", "strong", "supporting", "light"] },
          "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
          "usage_instruction": { "$ref": "common.schema.json#/$defs/non_empty_string" },
          "evidence_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/identifier" } }
        },
        "allOf": [
          {
            "if": { "properties": { "input_type": { "const": "protected_asset" } }, "required": ["input_type"] },
            "then": { "required": ["protected_elements", "allowed_operations"] }
          },
          {
            "if": { "properties": { "input_type": { "enum": ["creative_evidence", "negative_evidence"] } }, "required": ["input_type"] },
            "then": { "required": ["influence", "confidence", "usage_instruction", "evidence_refs"] }
          }
        ]
      }
    },
    "renderer_contract": {
      "type": "object", "additionalProperties": false, "required": ["required_capabilities", "evaluation_order"],
      "properties": {
        "required_capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
        "evaluation_order": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } }
      }
    },
    "resolution_receipt_ref": { "$ref": "common.schema.json#/$defs/identifier" }
  },
  "$defs": {
    "compiler": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": { "id": { "const": "brand-world-production-compiler" }, "version": { "$ref": "common.schema.json#/$defs/version" } }
    },
    "versioned_ref": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": { "id": { "$ref": "common.schema.json#/$defs/identifier" }, "version": { "$ref": "common.schema.json#/$defs/version" }, "digest": { "$ref": "common.schema.json#/$defs/checksum" } }
    },
    "labeled_versioned_ref": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/identifier" },
        "version": { "$ref": "common.schema.json#/$defs/version" },
        "label": { "$ref": "common.schema.json#/$defs/non_empty_string" }
      }
    }
  }
}
